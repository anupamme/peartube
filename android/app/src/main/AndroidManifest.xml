<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The Wi-Fi multicast lock that LAN discovery (mDNS) needs while the app is in front. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:name=".PearTubeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="PearTube"
        android:supportsRtl="true"
        android:theme="@style/Theme.PearTube">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- The launcher entry keeps the Dioxus app's component name, so an update
             in place keeps existing home-screen icons. -->
        <activity-alias
            android:name="dev.dioxus.main.MainActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
