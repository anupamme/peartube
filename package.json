{
  "name": "peartube",
  "version": "0.4.29",
  "description": "Decentralized CDN and debrid provider on the Holepunch stack",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "imports": {
    "node:crypto": {
      "bare": "peartube-crypto",
      "default": "node:crypto"
    },
    "node:fs": {
      "bare": "bare-fs",
      "default": "node:fs"
    },
    "node:http": {
      "bare": "bare-http1",
      "default": "node:http"
    },
    "node:https": {
      "bare": "bare-https",
      "default": "node:https"
    },
    "node:net": {
      "bare": "bare-net",
      "default": "node:net"
    },
    "node:os": {
      "bare": "bare-os",
      "default": "node:os"
    },
    "node:path": {
      "bare": "bare-path",
      "default": "node:path"
    },
    "buffer": {
      "bare": "bare-buffer",
      "default": "node:buffer"
    },
    "crypto": {
      "bare": "peartube-crypto",
      "default": "node:crypto"
    },
    "dgram": {
      "bare": "bare-dgram",
      "default": "node:dgram"
    },
    "events": {
      "bare": "bare-events",
      "default": "node:events"
    },
    "net": {
      "bare": "bare-net",
      "default": "node:net"
    },
    "os": {
      "bare": "bare-os",
      "default": "node:os"
    }
  },
  "bin": {
    "peartube-relay": "bin/relay.js"
  },
  "scripts": {
    "postinstall": "cp patches/hyperdht-private/* node_modules/hyperdht/lib/private/ 2>/dev/null || true",
    "start": "bare bin/relay.js",
    "test": "node --test test/*.test.js",
    "test:desktop": "node --test test/desktop.e2e.js",
    "app": "sh desktop/bundle.sh --open"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@p2plabs/hyperdht-mdns": "1.3.0",
    "autobee": "2.10.1",
    "b4a": "^1.8.0",
    "bare": "1.34.0",
    "bare-buffer": "^3.7.1",
    "bare-dgram": "1.1.1",
    "bare-events": "^2.9.1",
    "bare-fs": "^4.7.2",
    "bare-http1": "^4.6.2",
    "bare-https": "^3.1.0",
    "bare-net": "2.3.3",
    "bare-os": "3.9.1",
    "bare-path": "^3.0.1",
    "bare-process": "4.5.1",
    "bonjour-service": "^1.4.4",
    "corestore": "^7.12.6",
    "hyperblobs": "^2.12.1",
    "hyperdht": "github:ayooooo123/hyperdht#39d8f8b0e862446ae3a045651ccda9210c6f2146",
    "hypercore-blob-server": "^1.15.0",
    "hyperswarm": "^4.17.2",
    "peartube-crypto": "file:worklet/crypto",
    "sodium-native": "github:ayooooo123/sodium-native#562d642e1a78a8e124cf97bfbda77f01c02d1a7f",
    "streamx": "^2.28.0"
  },
  "devDependencies": {
    "bare-link": "3.3.1",
    "bare-pack": "2.2.2"
  },
  "overrides": {
    "hyperdht": "$hyperdht",
    "sodium-native": "$sodium-native"
  },
  "private": true
}
