{
  "name": "peartube",
  "version": "0.4.19",
  "description": "Decentralized CDN and debrid provider on the Holepunch stack",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "imports": {
    "node:crypto": {
      "bare": "peartube-crypto",
      "default": "node:crypto"
    },
    "node:net": {
      "bare": "bare-net",
      "default": "node:net"
    },
    "node:path": {
      "bare": "bare-path",
      "default": "node:path"
    }
  },
  "bin": {
    "peartube-relay": "bin/relay.js"
  },
  "scripts": {
    "start": "node bin/relay.js",
    "test": "node --test test/*.test.js",
    "test:desktop": "node --test test/desktop.e2e.js",
    "app": "sh desktop/bundle.sh --open"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@p2plabs/hyperdht-mdns": "1.3.0",
    "autobee": "2.10.1",
    "b4a": "^1.8.0",
    "bonjour-service": "^1.4.4",
    "corestore": "^7.12.6",
    "hyperblobs": "^2.12.1",
    "hypercore-blob-server": "^1.15.0",
    "hyperswarm": "^4.17.2",
    "streamx": "^2.28.0"
  },
  "devDependencies": {
    "bare": "1.34.0",
    "bare-dgram": "1.1.1",
    "bare-link": "3.3.1",
    "bare-net": "2.3.3",
    "bare-os": "3.9.1",
    "bare-pack": "2.2.2",
    "bare-process": "4.5.1",
    "hyperdht": "^6.34.0",
    "peartube-crypto": "file:worklet/crypto",
    "sodium-native": "^5.1.0"
  },
  "private": true
}
